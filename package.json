{
  "name": "nxt",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "db:deploy": "node tools/prisma-env.mjs migrate deploy",
    "db:status": "node tools/prisma-env.mjs migrate status",
    "db:migrate": "node tools/prisma-env.mjs migrate dev",
    "audit:gate": "npm audit --omit=dev --json | node tools/audit-gate.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "prettier": "^3.4.2"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.19",
    "js-yaml": "^5.2.2",
    "exceljs": {
      "archiver": "^8.0.0",
      "unzipper": "^0.12.3"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.12.1"
}
